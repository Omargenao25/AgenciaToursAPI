@model ClientesListadoViewModel
@{ ViewData["Title"] = "Gestionar clientes"; }
<section class="inner-hero dashboard-hero">
  <div class="container">
    <a class="back-link" asp-controller="Panel" asp-action="Index">← Volver al dashboard</a>
    <span class="eyebrow">OPERACIONES · TOURSMART RD</span>
    <h1>Gestión de <em>clientes.</em></h1>
    <p>Consulta y organiza los datos de quienes confían en nuestra agencia.</p>
  </div>
</section>
<section class="section-space"><div class="container">
  @if (TempData["Exito"] is string exito) { <div class="alert alert-success" role="status">@exito</div> }
  @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
  <div class="dashboard-head mb-4">
    <div><span class="eyebrow">DIRECTORIO DE CLIENTES</span><h2>Personas que <em>viajan con nosotros.</em></h2></div>
    <a class="btn btn-accent" asp-controller="ClientesAdmin" asp-action="Crear">+ Registrar cliente ↗</a>
  </div>
  <form method="get" asp-controller="ClientesAdmin" asp-action="Index" class="reservation-filters row g-3 align-items-end mb-4">
    <div class="col-lg-10">
      <label for="busqueda" class="form-label">Buscar por nombre, apellido, documento, correo o ID</label>
      <input class="form-control" id="busqueda" name="busqueda" maxlength="100" value="@Model.Busqueda" placeholder="Ej. Luis, nombre@correo.com o 5" />
    </div>
    <div class="col-lg-2 d-grid"><button class="btn btn-dark-pill" type="submit">Buscar ↗</button></div>
  </form>
  @if (!Model.ApiDisponible)
  {
    <div class="service-alert" role="alert">@Model.Error</div>
  }
  else
  {
    <div class="dashboard-table">
      <div class="dashboard-table-title"><h3>Clientes registrados</h3><span>@Model.Total resultado(s)</span></div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>ID</th><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Documento</th><th>Acciones</th></tr></thead>
          <tbody>
          @foreach (var cliente in Model.Clientes)
          {
            <tr>
              <td>#@cliente.Id</td>
              <td><strong>@cliente.Nombre @cliente.Apellido</strong></td>
              <td>@cliente.Telefono</td>
              <td>@cliente.Correo</td>
              <td><strong>@cliente.NumeroDocumento</strong><small class="d-block text-secondary">@cliente.TipoDocumento · @cliente.PaisEmisorDocumento</small></td>
              <td><a class="btn btn-sm btn-outline-success" asp-controller="ClientesAdmin" asp-action="Editar" asp-route-id="@cliente.Id">Editar</a></td>
            </tr>
          }
          @if (!Model.Clientes.Any())
          {
            <tr><td colspan="6" class="text-secondary py-4">No se encontraron clientes con esta búsqueda.</td></tr>
          }
          </tbody>
        </table>
      </div>
      <div class="reservation-pagination">
        <span>Página @Model.Pagina de @Model.TotalPaginas</span>
        <div class="d-flex gap-2">
          @if (Model.Pagina > 1)
          {
            <a class="btn btn-sm btn-outline-secondary" asp-controller="ClientesAdmin" asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina - 1)">← Anterior</a>
          }
          @if (Model.Pagina < Model.TotalPaginas)
          {
            <a class="btn btn-sm btn-outline-secondary" asp-controller="ClientesAdmin" asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina + 1)">Siguiente →</a>
          }
        </div>
      </div>
    </div>
  }
  <p class="dashboard-footnote">Por seguridad, esta sección solo es accesible al personal autorizado. La eliminación de clientes no se habilita desde esta interfaz para preservar la relación con sus reservas.</p>
</div></section>
