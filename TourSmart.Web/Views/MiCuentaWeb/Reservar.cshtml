@model MiReservaFormulario
@{ ViewData["Title"] = "Reservar excursión"; }
<section class="inner-hero dashboard-hero"><div class="container">
<a class="back-link" asp-controller="Tours" asp-action="Detalle" asp-route-id="@Model.TourId">← Volver al tour</a>
<span class="eyebrow">TOURSMART RD · RESERVAS</span><h1>Reserva tu <em>aventura.</em></h1>
<p>Solicita tus plazas. El equipo confirmará la reserva posteriormente.</p>
</div></section>
<section class="section-space ts-client-section">
<div class="container">
  <div class="ts-client-stepper" aria-label="Proceso de reserva">
    <span class="is-current"><b>01</b> Selecciona viajeros</span>
    <span><b>02</b> Solicitud pendiente</span>
    <span><b>03</b> Verificación de adelanto</span>
  </div>
  <div class="row g-4 g-xl-5">
    <div class="col-lg-7">
      <div class="ts-client-surface ts-booking-form">
        <span class="eyebrow">PASO 01 · TU RESERVA</span>
        <h2>Cuéntanos quiénes <em>viajarán.</em></h2>
        <p class="text-secondary mb-4">Completa los datos de cada pasajero. Todavía no se realizará ningún cobro.</p>
        <form method="post" asp-controller="MiCuentaWeb" asp-action="Reservar" asp-route-tourId="@Model.TourId" id="miReservaForm">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="TourId" />
          <div asp-validation-summary="ModelOnly" role="alert" class="text-danger mb-3"></div>
          <div class="row g-3">
            <div class="col-md-6">
              <label asp-for="CantidadPersonas" class="form-label">Número de viajeros</label>
              <input asp-for="CantidadPersonas" class="form-control" type="number" min="1" max="100" />
              <span asp-validation-for="CantidadPersonas" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="MetodoPagoId" class="form-label">Método de pago previsto</label>
              <select asp-for="MetodoPagoId" asp-items="Model.Metodos" class="form-select"><option value="0">Selecciona un método</option></select>
              <span asp-validation-for="MetodoPagoId" class="text-danger small"></span>
            </div>
          </div>
          <div class="ts-client-passengers mt-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
              <h3 class="h5 mb-0">Lista de pasajeros</h3>
              <span class="ts-client-counter" id="pasajerosContador" aria-live="polite">@Model.CantidadPersonas viajero(s)</span>
            </div>
            <p class="text-secondary small">Introduce los nombres completos, incluido el titular únicamente si viajará.</p>
            <div id="listaPasajeros">
              @for (var i=0; i<Model.Pasajeros.Count; i++)
              {
                <div class="mb-2">
                  <label class="form-label" for="pasajero_@i">Pasajero @(i + 1)</label>
                  <input id="pasajero_@i" name="Pasajeros[@i]" value="@Model.Pasajeros[i]" class="form-control" maxlength="120" minlength="3" required autocomplete="off" />
                </div>
              }
            </div>
            <span asp-validation-for="Pasajeros" class="text-danger small"></span>
          </div>
          <div class="ts-client-assurance mt-4" role="note">
            <span aria-hidden="true">✦</span>
            <p class="mb-0">Tu solicitud comenzará en estado <strong>Pendiente</strong>. La agencia verificará el adelanto antes de confirmarla. No se procesan pagos en línea.</p>
          </div>
          <button type="submit" class="btn btn-accent ts-client-submit mt-4" id="enviarReserva">Solicitar mi reserva <span aria-hidden="true">↗</span></button>
          <p class="text-secondary small mt-3 mb-0">Al solicitar, los cupos se contabilizan mientras la reserva esté activa. La agencia debe verificar los pagos.</p>
        </form>
      </div>
    </div>
    <div class="col-lg-5">
      <aside class="ts-client-surface ts-client-booking-summary" aria-label="Resumen estimado de la reserva">
        <span class="eyebrow">TU EXPERIENCIA</span>
        @if (Model.Tour is not null)
        {
          <div class="ts-client-mini-photo @(string.IsNullOrWhiteSpace(Model.Tour.ImagenMostrarUrl) ? "" : "has-photo")">
            @if (!string.IsNullOrWhiteSpace(Model.Tour.ImagenMostrarUrl))
            {
              <img src="@Model.Tour.ImagenMostrarUrl" alt="Imagen de @Model.Tour.Nombre" loading="lazy" referrerpolicy="no-referrer" />
            }
            <span>@Model.Tour.Destino</span>
          </div>
          <h3 class="mt-3">@Model.Tour.Nombre</h3>
          <p class="text-secondary small">@Model.Tour.Destino, @Model.Tour.Pais</p>
          <div class="ts-client-summary-line"><span>Fecha de salida</span><strong>@Model.Tour.Fecha.ToString("dd/MM/yyyy")</strong></div>
          <div class="ts-client-summary-line"><span>Hora</span><strong>@Model.Tour.Hora.ToString(@"hh\:mm")</strong></div>
          <div class="ts-client-summary-line"><span>Precio por persona</span><strong>RD$ @Model.Tour.Precio.ToString("N2")</strong></div>
          <div class="ts-client-summary-line"><span>Viajeros</span><strong id="personasResumen">@Model.CantidadPersonas</strong></div>
          <div class="ts-client-summary-line ts-client-summary-total"><span>Total estimado</span><strong id="totalReservaResumen" data-precio="@Model.Tour.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">RD$ @(Model.Tour.Precio * Model.CantidadPersonas).ToString("N2")</strong></div>
          {
            var totalEstimado = Model.Tour.Precio * Model.CantidadPersonas;
            var adelantoEstimado = Math.Ceiling(totalEstimado * Model.Tour.PorcentajeAdelanto) / 100m;
          }
          <div class="ts-client-deposit">
            <span>Adelanto mínimo estimado (@Model.Tour.PorcentajeAdelanto%)</span>
            <strong id="adelantoResumen" data-precio="@Model.Tour.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-porcentaje="@Model.Tour.PorcentajeAdelanto">RD$ @adelantoEstimado.ToString("N2")</strong>
            <small>La agencia debe registrar el adelanto en un plazo de @Model.Tour.HorasLimiteAdelanto horas desde la solicitud. Si vence sin pagos, las plazas se liberan. Los pagos registrados requieren revisión manual.</small>
          </div>
          @if (!string.IsNullOrWhiteSpace(Model.Tour.PuntoEncuentro))
          {
            <div class="ts-client-summary-line"><span>Punto de encuentro</span><strong>@Model.Tour.PuntoEncuentro</strong></div>
          }
        }
        else
        {
          <p class="text-secondary mt-3">La información del tour se mostrará cuando el servicio esté disponible.</p>
        }
        <a class="ts-client-return-link mt-3 d-inline-block" asp-controller="Tours" asp-action="Detalle" asp-route-id="@Model.TourId">← Revisar detalles del tour</a>
      </aside>
    </div>
  </div>
</div>
</section>
@section Scripts {
<script>
(function () {
  const cantidad = document.getElementById("CantidadPersonas");
  const lista = document.getElementById("listaPasajeros");
  if (!cantidad || !lista) return;
  const actualizarNombres = () => {
    const n = Math.min(100, Math.max(1, Number(cantidad.value) || 1));
    const valores = Array.from(lista.querySelectorAll('input[name^="Pasajeros["]')).map(x => x.value);
    const contador = document.getElementById("pasajerosContador");
    if (contador) contador.textContent = n + (n === 1 ? " viajero" : " viajeros");
    lista.replaceChildren();
    for (let i=0; i<n; i++) {
      const grupo=document.createElement("div");
      grupo.className="mb-2";
      const label=document.createElement("label");
      label.className="form-label";
      label.htmlFor="pasajero_"+i;
      label.textContent="Pasajero "+(i+1);
      const campo=document.createElement("input");
      campo.id="pasajero_"+i;
      campo.name="Pasajeros["+i+"]";
      campo.value=valores[i] || "";
      campo.className="form-control";
      campo.required=true;
      campo.minLength=3;
      campo.maxLength=120;
      campo.autocomplete="off";
      grupo.append(label,campo);
      lista.append(grupo);
    }
  };
  cantidad.addEventListener("change", actualizarNombres);
  cantidad.addEventListener("input", actualizarNombres);
  actualizarNombres();
})();

const campoPersonas = document.getElementById("CantidadPersonas");
const adelantoResumen = document.getElementById("adelantoResumen");
if (campoPersonas && adelantoResumen) {
  const actualizarAdelanto = () => {
    const personas = Math.max(1, Number(campoPersonas.value) || 1);
    const precio = Number(adelantoResumen.dataset.precio);
    const porcentaje = Number(adelantoResumen.dataset.porcentaje);
    const centavos = Math.ceil((precio * personas * porcentaje) - 1e-8);
    document.getElementById("personasResumen").textContent = personas;
    adelantoResumen.textContent = "RD$ " + (centavos / 100).toLocaleString("en-US", {minimumFractionDigits:2, maximumFractionDigits:2});
    const totalResumen = document.getElementById("totalReservaResumen");
    if (totalResumen) {
      totalResumen.textContent = "RD$ " + (precio * personas).toLocaleString("en-US", {minimumFractionDigits:2, maximumFractionDigits:2});
    }
  };
  campoPersonas.addEventListener("input", actualizarAdelanto);
  actualizarAdelanto();
}
document.getElementById("miReservaForm").addEventListener("submit", function () {
  if (!this.checkValidity()) return;
  document.getElementById("enviarReserva").disabled = true;
});
</script>
}
