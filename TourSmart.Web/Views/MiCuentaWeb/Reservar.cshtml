@model MiReservaFormulario
@{ ViewData["Title"] = "Reservar excursión"; }
<section class="inner-hero dashboard-hero"><div class="container">
<a class="back-link" asp-controller="Tours" asp-action="Detalle" asp-route-id="@Model.TourId">← Volver al tour</a>
<span class="eyebrow">TOURSMART RD · RESERVAS</span><h1>Reserva tu <em>aventura.</em></h1>
<p>Solicita tus plazas. El equipo confirmará la reserva posteriormente.</p>
</div></section>
<section class="section-space"><div class="container"><div class="tour-admin-form">
@if (Model.Tour is not null)
{
<h2>@Model.Tour.Nombre</h2><p class="text-secondary">RD$ @Model.Tour.Precio.ToString("N2") por persona · @Model.Tour.CuposDisponibles plazas disponibles</p>
}
<form method="post" asp-controller="MiCuentaWeb" asp-action="Reservar" asp-route-tourId="@Model.TourId" id="miReservaForm">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="TourId" />
<div asp-validation-summary="ModelOnly" role="alert" class="text-danger mb-3"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="CantidadPersonas" class="form-label">Personas</label><input asp-for="CantidadPersonas" class="form-control" type="number" min="1" max="100"/><span asp-validation-for="CantidadPersonas" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="MetodoPagoId" class="form-label">Método de pago</label>
<select asp-for="MetodoPagoId" asp-items="Model.Metodos" class="form-select"><option value="0">Selecciona un método</option></select><span asp-validation-for="MetodoPagoId" class="text-danger small"></span></div>
</div>
                <div class="mt-4">
                    <h3 class="h5">Nombres de los pasajeros</h3>
                    <p class="text-secondary small">Introduce el nombre completo de cada persona, incluido el titular solo si viajará.</p>
                    <div id="listaPasajeros">
                    @for (var i = 0; i < Model.Pasajeros.Count; i++)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="pasajero_@i">Pasajero @(i+1)</label>
                            <input id="pasajero_@i" name="Pasajeros[@i]" value="@Model.Pasajeros[i]" class="form-control" maxlength="120" minlength="3" required autocomplete="off" />
                        </div>
                    }
                    </div>
                    <span asp-validation-for="Pasajeros" class="text-danger small"></span>
                </div>
@if (Model.Tour is not null)
{
    var totalEstimado = Model.Tour.Precio * Model.CantidadPersonas;
    var adelantoEstimado = Math.Ceiling(totalEstimado * Model.Tour.PorcentajeAdelanto) / 100m;
    <div class="booking-status mt-4">
        Esta solicitud no realiza un cobro. Se creará como <strong>Pendiente</strong>.
        Para confirmarla, la agencia debe verificar y registrar al menos un adelanto del
        <strong>@Model.Tour.PorcentajeAdelanto%</strong> de la reserva.
        Para <span id="personasResumen">@Model.CantidadPersonas</span> persona(s), el mínimo estimado es
        <strong id="adelantoResumen" data-precio="@Model.Tour.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-porcentaje="@Model.Tour.PorcentajeAdelanto">RD$ @adelantoEstimado.ToString("N2")</strong>.
        Tendrás <strong>@Model.Tour.HorasLimiteAdelanto horas</strong> desde que solicites la reserva para que la agencia registre el adelanto. Si el plazo vence sin ningún pago, la solicitud se cancelará y liberará sus plazas. Si existe un pago, la agencia deberá revisar la solicitud manualmente.
        Las plazas solicitadas se contabilizarán mientras la reserva esté activa.
    </div>
}
<button type="submit" class="btn btn-accent mt-3" id="enviarReserva">Solicitar reserva ↗</button>
</form>
</div></div></section>
@section Scripts {
<script>
(function () {
  const cantidad = document.getElementById("CantidadPersonas");
  const lista = document.getElementById("listaPasajeros");
  if (!cantidad || !lista) return;
  const actualizarNombres = () => {
    const n = Math.min(100, Math.max(1, Number(cantidad.value) || 1));
    const valores = Array.from(lista.querySelectorAll('input[name^="Pasajeros["]')).map(x => x.value);
    lista.replaceChildren();
    for (let i=0; i<n; i++) {
      const grupo=document.createElement("div");
      grupo.className="mb-2";
      const label=document.createElement("label");
      label.className="form-label";
      label.htmlFor="pasajero_"+i;
      label.textContent="Pasajero "+(i+1);
      const campo=document.createElement("input");
      campo.id="pasajero_"+i;
      campo.name="Pasajeros["+i+"]";
      campo.value=valores[i] || "";
      campo.className="form-control";
      campo.required=true;
      campo.minLength=3;
      campo.maxLength=120;
      campo.autocomplete="off";
      grupo.append(label,campo);
      lista.append(grupo);
    }
  };
  cantidad.addEventListener("change", actualizarNombres);
  cantidad.addEventListener("input", actualizarNombres);
  actualizarNombres();
})();

const campoPersonas = document.getElementById("CantidadPersonas");
const adelantoResumen = document.getElementById("adelantoResumen");
if (campoPersonas && adelantoResumen) {
  const actualizarAdelanto = () => {
    const personas = Math.max(1, Number(campoPersonas.value) || 1);
    const precio = Number(adelantoResumen.dataset.precio);
    const porcentaje = Number(adelantoResumen.dataset.porcentaje);
    const centavos = Math.ceil((precio * personas * porcentaje) - 1e-8);
    document.getElementById("personasResumen").textContent = personas;
    adelantoResumen.textContent = "RD$ " + (centavos / 100).toLocaleString("en-US", {minimumFractionDigits:2, maximumFractionDigits:2});
  };
  campoPersonas.addEventListener("input", actualizarAdelanto);
}
document.getElementById("miReservaForm").addEventListener("submit", function () {
  if (!this.checkValidity()) return;
  document.getElementById("enviarReserva").disabled = true;
});
</script>
}
