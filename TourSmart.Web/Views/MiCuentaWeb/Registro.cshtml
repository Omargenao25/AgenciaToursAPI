@model RegistroViajeroViewModel
@{ ViewData["Title"] = "Crear cuenta"; }
<section class="inner-hero dashboard-hero"><div class="container">
<span class="eyebrow">TOURSMART RD · VIAJEROS</span><h1>Tu aventura <em>comienza aquí.</em></h1>
<p>Crea tu cuenta de viajero para solicitar excursiones y consultar tus reservas.</p>
</div></section>
<section class="section-space"><div class="container">
<div class="tour-admin-form">
<h2 class="mb-4">Crear <em>mi cuenta.</em></h2>
<form method="post" asp-controller="MiCuentaWeb" asp-action="Registro" id="registroViajero">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" maxlength="80" autocomplete="given-name" /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
  <div class="col-md-6"><label asp-for="Apellido" class="form-label">Apellido</label><input asp-for="Apellido" class="form-control" maxlength="80" autocomplete="family-name" /><span asp-validation-for="Apellido" class="text-danger small"></span></div>
  <div class="col-md-6"><label asp-for="Correo" class="form-label">Correo electrónico</label><input asp-for="Correo" type="email" class="form-control" autocomplete="email" maxlength="150" required /><span asp-validation-for="Correo" class="text-danger small"></span><small class="text-secondary">Usa un correo real al que puedas acceder (Gmail, Outlook, Yahoo o empresarial). Podrías necesitar verificarlo mediante un enlace.</small></div>
  <div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" autocomplete="tel" maxlength="20" /><span asp-validation-for="Telefono" class="text-danger small"></span></div>
  <div class="col-md-6"><label asp-for="TipoDocumento" class="form-label">Documento de identidad</label>
   <select asp-for="TipoDocumento" class="form-select" id="tipoDocumento">
    <option value="CedulaDominicana">Cédula dominicana</option><option value="Pasaporte">Pasaporte</option><option value="Residencia">Carné de residencia</option><option value="Otro">Otro documento</option>
   </select></div>
  <div class="col-md-6"><label asp-for="PaisEmisorDocumento" class="form-label">País emisor</label><input asp-for="PaisEmisorDocumento" id="paisEmisor" maxlength="80" class="form-control"/><span asp-validation-for="PaisEmisorDocumento" class="text-danger small"></span></div>
  <div class="col-12"><label asp-for="NumeroDocumento" class="form-label">Número del documento</label><input asp-for="NumeroDocumento" id="numeroDocumento" class="form-control" autocomplete="off" maxlength="40"/><span asp-validation-for="NumeroDocumento" class="text-danger small"></span><small class="text-secondary" id="ayudaDocumento"></small></div>
  <div class="col-md-6"><label asp-for="Contrasena" class="form-label">Contraseña (mínimo 8 caracteres)</label><input asp-for="Contrasena" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Contrasena" class="text-danger small"></span></div>
  <div class="col-md-6"><label asp-for="ConfirmarContrasena" class="form-label">Repetir contraseña</label><input asp-for="ConfirmarContrasena" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span></div>
 </div>
 <p class="booking-note mt-4"><a asp-controller="MiCuentaWeb" asp-action="ReenviarVerificacion">¿Ya te registraste y no recibiste el enlace de verificación?</a></p>
 <p class="booking-note mt-4">Si ya tienes una ficha registrada en la agencia con este correo o documento, solicita su vinculación. No crees otra cuenta con una identidad ajena.</p>
 <div class="d-flex flex-wrap gap-3 mt-4"><button class="btn btn-accent" type="submit" id="botonRegistro">Crear cuenta ↗</button><a asp-controller="Cuenta" asp-action="Acceder" class="btn btn-outline-secondary rounded-pill px-4">Ya tengo cuenta</a></div>
</form>
</div></div></section>
@section Scripts {
<script>
const tipo = document.getElementById("tipoDocumento");
const pais = document.getElementById("paisEmisor");
const numero = document.getElementById("numeroDocumento");
function actualizarDocumento() {
  const esCedula = tipo.value === "CedulaDominicana";
  numero.pattern = esCedula ? "[0-9]{11}" : "[A-Za-z0-9-]{5,40}";
  numero.maxLength = esCedula ? 11 : 40;
  numero.minLength = esCedula ? 11 : 5;
  numero.inputMode = esCedula ? "numeric" : "text";
  document.getElementById("ayudaDocumento").textContent = esCedula
      ? "Introduce exactamente 11 dígitos."
      : "De 5 a 40 letras, números o guiones.";
  pais.readOnly = esCedula;
  if (esCedula) pais.value = "República Dominicana";
}
tipo.addEventListener("change", () => {
  numero.value = "";
  if (tipo.value !== "CedulaDominicana" && pais.value === "República Dominicana") pais.value = "";
  actualizarDocumento();
});
actualizarDocumento();
document.getElementById("registroViajero").addEventListener("submit", function () {
  if (!this.checkValidity()) return;
  document.getElementById("botonRegistro").disabled = true;
});
</script>
}
