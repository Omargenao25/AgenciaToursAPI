@model IReadOnlyList<ReservaPanel>
@{ ViewData["Title"] = "Mis reservas"; }
<section class="inner-hero dashboard-hero"><div class="container">
<span class="eyebrow">MI ESPACIO · TOURSMART RD</span><h1>Mis <em>reservas.</em></h1>
<p>Consulta tus experiencias y el estado de cada solicitud.</p>
</div></section>
<section class="section-space"><div class="container">
@if (TempData["Exito"] is string exito) { <div class="alert alert-success" role="status">@exito</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
<div class="dashboard-head mb-4"><h2>Mis <em>viajes.</em></h2><div class="d-flex gap-2 flex-wrap"><a class="btn btn-dark-pill" asp-controller="MiCuentaWeb" asp-action="Perfil">Mi perfil ↗</a><a class="btn btn-accent" asp-controller="Tours" asp-action="Index">Explorar tours ↗</a></div></div>
<div class="ts-client-reservations-grid">
@if (!Model.Any())
{
  <div class="ts-client-empty">
    <span class="ts-client-empty-icon" aria-hidden="true">✈</span>
    <h3>Tu próxima aventura comienza aquí</h3>
    <p>Aún no tienes reservas. Explora las excursiones disponibles y encuentra la que más te inspire.</p>
    <a class="btn btn-accent" asp-controller="Tours" asp-action="Index">Descubrir experiencias ↗</a>
  </div>
}
else
{
  @foreach (var item in Model.OrderByDescending(x => x.FechaReserva))
  {
    <article class="ts-client-reservation-card">
      <div class="ts-client-reservation-top">
        <span class="ts-client-booking-id">RESERVA #@item.Id</span>
        <span class="reservation-status @(item.Estado == "Confirmada" ? "is-confirmed" : item.Estado == "Cancelada" ? "is-cancelled" : "is-pending")">@item.Estado</span>
      </div>
      <h3>@item.Tour</h3>
      @if (item.Estado == "Pendiente")
      {
        <div class="ts-client-next-action is-pending">
          <strong>¿Qué sigue?</strong>
          <span>Revisa el adelanto requerido y las instrucciones bancarias de la agencia. Tu solicitud aún no está confirmada.</span>
        </div>
      }
      else if (item.Estado == "Confirmada")
      {
        <div class="ts-client-next-action is-confirmed">
          <strong>¡Reserva confirmada!</strong>
          <span>Consulta los detalles de salida y conserva tu constancia junto con tu identificación.</span>
        </div>
      }
      else if (item.Estado == "Cancelada")
      {
        <div class="ts-client-next-action is-cancelled">
          <strong>Reserva cancelada</strong>
          <span>Puedes conservar la constancia histórica y consultar nuevas experiencias.</span>
        </div>
      }
      <div class="ts-client-reservation-data">
        <div><span>Salida</span><strong>@(item.FechaTour?.ToString("dd/MM/yyyy") ?? "Por confirmar")</strong></div>
        <div><span>Viajeros</span><strong>@item.CantidadPersonas</strong></div>
        <div><span>Total de la reserva</span><strong>RD$ @item.Total.ToString("N2")</strong></div>
      </div>
      <div class="ts-client-reservation-actions">
        <a class="btn btn-dark-pill btn-sm" asp-controller="MiCuentaWeb" asp-action="Comprobante" asp-route-id="@item.Id">Ver comprobante ↗</a>
        @if (item.TourId > 0)
        {
          <a class="btn btn-outline-secondary btn-sm" asp-controller="Tours" asp-action="Detalle" asp-route-id="@item.TourId">Ver excursión</a>
        }
        <a class="btn btn-outline-primary btn-sm" asp-controller="AdelantosWeb" asp-action="MiReserva" asp-route-id="@item.Id">Adelanto / pago</a>
        @if (item.PuedeCancelar)
        {
          <form asp-controller="MiCuentaWeb" asp-action="CancelarMiReserva" asp-route-id="@item.Id" method="post" class="mi-cancel-form" data-reserva="@item.Id" data-tour="@item.Tour">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar reserva</button>
          </form>
        }
      </div>
    </article>
  }
}
</div>
<p class="dashboard-footnote">Puedes cancelar una reserva pendiente o confirmada antes del inicio de su tour. Se conserva el registro en tu historial y las plazas vuelven a estar disponibles.</p>
</div></section>

@section Scripts {
<script>
document.querySelectorAll(".mi-cancel-form").forEach(form => {
  form.addEventListener("submit", event => {
    const numero = form.dataset.reserva;
    const tour = form.dataset.tour;
    if (!window.confirm("¿Quieres cancelar la reserva #" + numero + " de " + tour + "? Esta acción no se puede deshacer desde tu cuenta.")) {
      event.preventDefault();
      return;
    }
    if (!form.checkValidity()) return;
    const boton = form.querySelector('button[type="submit"]');
    if (boton) {
      boton.disabled = true;
      boton.textContent = "Cancelando...";
    }
  });
});
</script>
}
