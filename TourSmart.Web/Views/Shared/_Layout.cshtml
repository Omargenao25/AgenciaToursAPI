<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1e2b" />
    <title>@ViewData["Title"] · TourSmart RD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container py-3" aria-label="Navegación principal">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">✦</span> TourSmart<span class="brand-rd">RD</span></a>
            <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tours" asp-action="Index">Explorar tours</a></li>
                    <li class="nav-item"><span class="nav-link nav-soon" title="Próximamente">Mis reservas <small>Próximamente</small></span></li>
                    <li class="nav-item"><span class="btn btn-light nav-disabled" title="Próximamente">Acceder <span>↗</span></span></li>
                </ul>
            </div>
        </nav>
    </header>
    <main>@RenderBody()</main>
    <footer class="site-footer">
        <div class="container py-5 d-flex flex-wrap justify-content-between gap-3">
            <div><div class="brand footer-brand"><span class="brand-mark">✦</span> TourSmart<span class="brand-rd">RD</span></div><p class="footer-copy mt-2 mb-0">Explora más. Viaja mejor.</p></div>
            <div class="footer-copy">Proyecto Integrador II · Plataforma turística en desarrollo<br />© @DateTime.Now.Year TourSmart RD</div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
