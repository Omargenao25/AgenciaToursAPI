<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102f34" />
    <meta name="description" content="TourSmart RD: descubre excursiones, reserva tus plazas y gestiona tus experiencias." />
    <title>@ViewData["Title"] · TourSmart RD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toursmart-v3.css" asp-append-version="true" />
</head>
<body>
    <a class="ts-skip" href="#contenido-principal">Saltar al contenido</a>
    <header class="site-header ts-v3-header">
        <nav class="navbar navbar-expand-lg container py-3" aria-label="Navegación principal">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">✦</span><span class="brand-name">TourSmart<span class="brand-rd">RD</span><small class="brand-subtitle">EXPERIENCIAS & EXCURSIONES</small></span></a>
            <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "page" : null)">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tours" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Tours" ? "page" : null)">Explorar tours</a></li>
                    @if (User.IsInRole("Cliente"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="MiCuentaWeb" asp-action="MisReservas">Mis reservas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MiCuentaWeb" asp-action="Perfil">Mi perfil</a></li>
                    }
                    @if (User.IsInRole("Administrador") || User.IsInRole("Operador"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="ReservasWeb" asp-action="Index">Reservas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Index">Panel de control</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ToursAdmin" asp-action="Index">Tours</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="GeografiaAdmin" asp-action="Index">Destinos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="CategoriasAdmin" asp-action="Index">Categorías</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="TransportesAdmin" asp-action="Index">Transportes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PortadaAdmin" asp-action="Index">Portada</a></li>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Index">Mi espacio</a></li>
                        <li class="nav-item">
                            <form method="post" asp-controller="Cuenta" asp-action="Salir" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-light nav-login" type="submit">Salir ↗</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-light nav-login" asp-controller="Cuenta" asp-action="Acceder">Acceder ↗</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <main id="contenido-principal" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer">
        <div class="container py-5 d-flex flex-wrap justify-content-between align-items-start gap-4">
            <div><span class="ts-footer-eyebrow">PLANEA · DESCUBRE · VIAJA</span><div class="brand footer-brand"><span class="brand-mark">✦</span> TourSmart<span class="brand-rd">RD</span></div><p class="footer-copy mt-2 mb-0">Cada destino merece una gran historia.<br />Encuentra la próxima con TourSmart RD.</p></div>
            <div class="d-flex flex-column gap-2 align-items-start align-items-md-end"><div class="ts-footer-links"><a class="footer-copy" asp-controller="Tours" asp-action="Index">Excursiones</a><a class="footer-copy" asp-controller="Home" asp-action="Index">Inicio</a>@if (User.Identity?.IsAuthenticated == true) { <a class="footer-copy" asp-controller="Panel" asp-action="Index">Mi espacio</a> }</div><div class="footer-copy">Proyecto Integrador II · Plataforma turística en desarrollo<br />© @DateTime.Now.Year TourSmart RD</div></div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
