@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<section class="auth-section">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-intro">
                <span class="eyebrow">BIENVENIDO A TOURSMART RD</span>
                <h1>Bienvenido a tu <em>próxima aventura.</em></h1>
                <p>Todo lo que necesitas para descubrir, reservar y disfrutar tus excursiones, en un solo lugar.</p>
                <div class="auth-deco" aria-hidden="true"><span>✦</span><span>EXPLORE MORE</span></div>
            </div>
            <div class="auth-form-panel">
                <span class="eyebrow">TU CUENTA</span>
                <h2>¡Qué bueno <em>verte otra vez!</em></h2>
                <p class="text-secondary mb-4">Introduce tus credenciales para continuar.</p>
                @if (TempData["ContrasenaActualizada"] is string aviso)
                {
                    <div class="alert alert-success" role="status">@aviso</div>
                }
                <form asp-controller="Cuenta" asp-action="Acceder" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="tu@correo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Contrasena" class="form-label">Contraseña</label>
                        <input asp-for="Contrasena" class="form-control" type="password" autocomplete="current-password" placeholder="Tu contraseña" />
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-accent w-100">Iniciar sesión ↗</button>
                </form>
<p class="text-secondary small mt-3">¿Tu cuenta está pendiente? <a asp-controller="MiCuentaWeb" asp-action="ReenviarVerificacion">Reenviar verificación de correo</a>.</p>
                <p class="auth-help"><a asp-controller="Cuenta" asp-action="Recuperar">¿Olvidaste tu contraseña?</a></p>
                <p class="auth-help">¿No tienes una cuenta? <a asp-controller="MiCuentaWeb" asp-action="Registro">Crear cuenta de viajero</a>.</p>
            </div>
        </div>
    </div>
</section>
