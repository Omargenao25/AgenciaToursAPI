@model RestablecerContrasenaViewModel
@{ ViewData["Title"] = "Crear nueva contraseña"; }
<section class="auth-section"><div class="container"><div class="auth-shell">
<div class="auth-intro">
<span class="eyebrow">TOURSMART RD · SEGURIDAD</span>
<h1>Una nueva <em>contraseña.</em></h1>
<p>El enlace de recuperación es de un solo uso y tiene una validez de 15 minutos.</p>
</div>
<div class="auth-form-panel">
<h2>Restablecer <em>acceso.</em></h2>
<form method="post" asp-controller="Cuenta" asp-action="Restablecer">
 @Html.AntiForgeryToken()
 <input type="hidden" asp-for="Token"/>
 <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
 <div class="mb-3"><label asp-for="ContrasenaNueva" class="form-label">Nueva contraseña</label>
 <input asp-for="ContrasenaNueva" type="password" autocomplete="new-password" class="form-control" minlength="10" maxlength="100"/>
 <span asp-validation-for="ContrasenaNueva" class="text-danger small"></span></div>
 <div class="mb-3"><label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña</label>
 <input asp-for="ConfirmarContrasena" type="password" autocomplete="new-password" class="form-control"/>
 <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span></div>
 <p class="booking-note">Usa 10 caracteres como mínimo, mayúscula, minúscula, número y símbolo; no reutilices tu contraseña anterior.</p>
 <button type="submit" class="btn btn-accent w-100">Guardar nueva contraseña ↗</button>
</form>
</div></div></div></section>
