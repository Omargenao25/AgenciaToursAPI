@model IReadOnlyList<TourCard>
@{ ViewData["Title"] = "Administrar tours"; }
<section class="inner-hero dashboard-hero">
 <div class="container">
  <a asp-controller="Panel" asp-action="Index" class="back-link">← Volver al dashboard</a>
  <span class="eyebrow">OPERACIONES · TOURSMART RD</span>
  <h1>Gestiona tus <em>experiencias.</em></h1>
  <p>Controla los precios, fechas y plazas de los tours de tu agencia.</p>
 </div>
</section>
<section class="section-space"><div class="container">
 @if (TempData["Exito"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
 @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
 <div class="dashboard-head mb-4">
  <div><span class="eyebrow">CATÁLOGO ADMINISTRATIVO</span><h2>Todos los <em>tours.</em></h2><p>@Model.Count excursiones registradas</p></div>
  <div class="d-flex flex-wrap gap-2"><a class="btn btn-accent" asp-controller="ToursAdmin" asp-action="Crear">+ Crear nuevo tour ↗</a><a class="btn btn-dark-pill" asp-controller="ReservasWeb" asp-action="Crear">+ Nueva reserva ↗</a></div>
 </div>
 <div class="dashboard-table"><div class="table-responsive">
  <table class="table align-middle">
   <thead><tr><th>Tour</th><th>Fecha</th><th>Precio</th><th>Capacidad</th><th>Estado</th><th>Acciones</th></tr></thead>
   <tbody>
   @foreach(var tour in Model.OrderBy(t=>t.Fecha))
   {
    <tr>
     <td><strong>@tour.Nombre</strong><small class="d-block text-secondary">@tour.Destino · @tour.Pais</small></td>
     <td>@tour.Fecha.ToString("dd/MM/yyyy")<small class="d-block text-secondary">@tour.Hora.ToString(@"hh\:mm")</small></td>
     <td>RD$ @tour.Precio.ToString("N2")</td>
     <td>@tour.CuposReservados / @tour.CapacidadMaxima<small class="d-block text-secondary">@tour.CuposDisponibles libres</small></td>
     <td><span class="reservation-status @(tour.Estado == "Disponible" ? "is-confirmed" : "is-pending")">@tour.Estado</span></td>
     <td>
      @if(tour.Estado == "Disponible") { <a class="btn btn-sm btn-outline-success" asp-controller="ToursAdmin" asp-action="Editar" asp-route-id="@tour.Id">Editar</a> }
      else { <span class="text-secondary small">Finalizado / iniciado</span> }
      <a class="btn btn-sm btn-outline-primary" asp-controller="ToursAdmin" asp-action="Adelanto" asp-route-id="@tour.Id">Adelanto</a>
      <a class="btn btn-sm btn-outline-secondary" asp-controller="Tours" asp-action="Detalle" asp-route-id="@tour.Id">Ver</a>
     </td>
    </tr>
   }
   @if(Model.Count == 0) { <tr><td colspan="6" class="text-secondary py-4">No hay tours para mostrar.</td></tr> }
   </tbody>
  </table>
 </div></div>
 <p class="dashboard-footnote">La API protege las reservas existentes. No se permite editar tours iniciados ni reducir la capacidad por debajo de los cupos ocupados.</p>
</div></section>
