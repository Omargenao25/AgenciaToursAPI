@model TourSmart.Web.Controllers.GeografiaListado
@{
    ViewData["Title"] = "Países y destinos";
    var paises = Model.Paises.ToDictionary(p => p.Id, p => p.Nombre);
}
<section class="inner-hero dashboard-hero">
    <div class="container">
        <a class="back-link" asp-controller="Panel" asp-action="Index">← Volver al panel</a>
        <span class="eyebrow">CATÁLOGOS · TOURSMART RD</span>
        <h1>Países y <em>destinos.</em></h1>
        <p>Organiza las ubicaciones que luego seleccionarás al crear excursiones.</p>
    </div>
</section>
<section class="section-space"><div class="container">
    @if (TempData["Exito"] is string exito) { <div class="alert alert-success" role="status">@exito</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    <div class="row g-4">
        <div class="col-lg-5">
            <section class="dashboard-table mb-4">
                <h2 class="h4 mb-3">@(Model.Pais.Id > 0 ? "Editar país" : "Nuevo país")</h2>
                <form method="post" asp-controller="GeografiaAdmin" asp-action="GuardarPais">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Pais.Id" />
                    <div class="mb-3">
                        <label asp-for="Pais.Nombre" class="form-label">Nombre del país</label>
                        <input asp-for="Pais.Nombre" class="form-control" maxlength="100" required placeholder="Ej. República Dominicana" />
                    </div>
                    <button type="submit" class="btn btn-accent">Guardar país</button>
                    @if (Model.Pais.Id > 0) { <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a> }
                </form>
            </section>
            <section class="dashboard-table">
                <h2 class="h4 mb-3">@(Model.Destino.Id > 0 ? "Editar destino" : "Nuevo destino")</h2>
                <form method="post" asp-controller="GeografiaAdmin" asp-action="GuardarDestino">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Destino.Id" />
                    <div class="mb-3">
                        <label asp-for="Destino.Nombre" class="form-label">Nombre del destino</label>
                        <input asp-for="Destino.Nombre" class="form-control" maxlength="100" required placeholder="Ej. Samaná" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Destino.PaisId" class="form-label">País al que pertenece</label>
                        <select asp-for="Destino.PaisId" class="form-select" required>
                            <option value="0">Selecciona un país</option>
                            @foreach (var pais in Model.Paises)
                            {
                                <option value="@pais.Id">@pais.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><label asp-for="Destino.DuracionDias" class="form-label">Duración (días)</label><input asp-for="Destino.DuracionDias" class="form-control" type="number" min="0" max="365" /></div>
                        <div class="col-6"><label asp-for="Destino.DuracionHoras" class="form-label">Duración (horas)</label><input asp-for="Destino.DuracionHoras" class="form-control" type="number" min="0" max="23" /></div>
                    </div>
                    <p class="text-secondary small">La duración debe ser mayor que cero. Los tours nuevos tomarán la duración del destino.</p>
                    <button type="submit" class="btn btn-accent">Guardar destino</button>
                    @if (Model.Destino.Id > 0) { <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a> }
                </form>
            </section>
        </div>
        <div class="col-lg-7">
            <section class="dashboard-table mb-4">
                <h2 class="h4 mb-3">Países registrados (@Model.Paises.Count)</h2>
                <div class="table-responsive"><table class="table align-middle">
                    <thead><tr><th>País</th><th>Destinos</th><th>Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var pais in Model.Paises)
                    {
                        <tr>
                            <td><strong>@pais.Nombre</strong></td>
                            <td>@Model.Destinos.Count(d => d.PaisId == pais.Id)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-paisId="@pais.Id">Editar</a>
                                <form class="d-inline eliminar-catalogo" asp-action="EliminarPais" asp-route-id="@pais.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Paises.Any()) { <tr><td colspan="3">Todavía no hay países registrados.</td></tr> }
                    </tbody>
                </table></div>
            </section>
            <section class="dashboard-table">
                <h2 class="h4 mb-3">Destinos registrados (@Model.Destinos.Count)</h2>
                <div class="table-responsive"><table class="table align-middle">
                    <thead><tr><th>Destino</th><th>País</th><th>Duración</th><th>Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var destino in Model.Destinos)
                    {
                        <tr>
                            <td><strong>@destino.Nombre</strong></td>
                            <td>@(paises.TryGetValue(destino.PaisId, out var nombrePais) ? nombrePais : "Desconocido")</td>
                            <td>@destino.DuracionDias d · @destino.DuracionHoras h</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-destinoId="@destino.Id">Editar</a>
                                <form class="d-inline eliminar-catalogo" asp-action="EliminarDestino" asp-route-id="@destino.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Destinos.Any()) { <tr><td colspan="4">Todavía no hay destinos registrados.</td></tr> }
                    </tbody>
                </table></div>
            </section>
        </div>
    </div>
</div></section>
@section Scripts {
<script>
document.querySelectorAll(".eliminar-catalogo").forEach(form => {
    form.addEventListener("submit", event => {
        if (!confirm("¿Eliminar este registro? Solo se permitirá si no tiene relaciones asociadas.")) event.preventDefault();
    });
});
</script>
}
