@model CrearReservaViewModel
@{
    ViewData["Title"] = "Crear reserva";
}
<section class="inner-hero dashboard-hero">
    <div class="container">
        <a class="back-link" asp-controller="ReservasWeb" asp-action="Index">← Volver a reservas</a>
        <span class="eyebrow">OPERACIONES · TOURSMART RD</span>
        <h1>Nueva <em>reserva.</em></h1>
        <p>Registra una nueva experiencia para un cliente de tu agencia.</p>
    </div>
</section>
<section class="section-space">
    <div class="container">
        <div class="tour-admin-form">
            <span class="eyebrow">DATOS DE RESERVA</span><div class="d-flex justify-content-end mb-3"><a class="btn btn-sm btn-outline-success" asp-controller="ClientesAdmin" asp-action="Crear">+ Registrar cliente nuevo</a></div>
            <h2 class="mt-2 mb-4">Comencemos <em>la aventura.</em></h2>
            <form method="post" asp-controller="ReservasWeb" asp-action="Crear" id="crearReservaForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                            <option value="0">Selecciona un cliente</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="small text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MetodoPagoId" class="form-label">Método de pago</label>
                        <select asp-for="MetodoPagoId" asp-items="Model.MetodosPago" class="form-select">
                            <option value="0">Selecciona un método</option>
                        </select>
                        <span asp-validation-for="MetodoPagoId" class="small text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="TourId" class="form-label">Excursión disponible</label>
                        <select asp-for="TourId" asp-items="Model.Tours" class="form-select">
                            <option value="0">Selecciona un tour</option>
                        </select>
                        <span asp-validation-for="TourId" class="small text-danger"></span>
                        <small class="text-secondary">Solo se muestran tours futuros con plazas disponibles.</small>
                        <div id="cuposTourAviso" class="mt-2 small" aria-live="polite">Selecciona un tour para ver su disponibilidad.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CantidadPersonas" class="form-label">Cantidad de personas</label>
                        <input asp-for="CantidadPersonas" type="number" min="1" max="100" class="form-control" />
                        <span asp-validation-for="CantidadPersonas" class="small text-danger"></span>
                        <small id="limitePasajerosAviso" class="d-block mt-2 text-secondary" aria-live="polite">El límite es de 100 personas por reserva y depende de las plazas del tour.</small>
                    </div>
                </div>
                <div class="mt-4">
                    <h3 class="h5">Nombres de los pasajeros</h3>
                    <p class="text-secondary small">Introduce el nombre completo de cada persona, incluido el titular solo si viajará.</p>
                    <div id="listaPasajeros">
                    @for (var i = 0; i < Model.Pasajeros.Count; i++)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="pasajero_@i">Pasajero @(i+1)</label>
                            <input id="pasajero_@i" name="Pasajeros[@i]" value="@Model.Pasajeros[i]" class="form-control" maxlength="120" minlength="3" required autocomplete="off" />
                        </div>
                    }
                    </div>
                    <span asp-validation-for="Pasajeros" class="text-danger small"></span>
                </div>
                <div class="booking-status mt-4">La reserva se creará en estado <strong>Pendiente</strong>. Se ocuparán las plazas indicadas hasta confirmar o cancelar la reserva.</div>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button type="submit" class="btn btn-accent" id="guardarReserva">Crear reserva ↗</button>
                    <a asp-controller="ReservasWeb" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
<script>
(function () {
  const cupos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CuposPorTour));
  const tour = document.getElementById("TourId");
  const cantidad = document.getElementById("CantidadPersonas");
  const lista = document.getElementById("listaPasajeros");
  const aviso = document.getElementById("cuposTourAviso");
  const limiteAviso = document.getElementById("limitePasajerosAviso");
  if (!cantidad || !lista || !tour || !aviso || !limiteAviso) return;
  const revisarCupos = () => {
    const disponibles = cupos[tour.value];
    const maximo = Number.isInteger(disponibles) ? Math.min(100, disponibles) : 100;
    cantidad.max = String(maximo);
    const total = Number(cantidad.value);
    const excedido = Number.isInteger(disponibles) && total > maximo;
    cantidad.setCustomValidity(excedido ? "Solo quedan " + disponibles + " plazas disponibles para este tour." : "");
    aviso.textContent = Number.isInteger(disponibles) ? "Disponibilidad actual: " + disponibles + " plazas." : "Selecciona un tour para ver su disponibilidad.";
    aviso.className = "mt-2 small " + (excedido ? "text-danger fw-semibold" : "text-secondary");
    limiteAviso.textContent = Number.isInteger(disponibles) ? "Puedes reservar hasta " + maximo + " personas en este tour." : "El límite por reserva es de 100 personas.";
  };
  const actualizarNombres = () => {
    const n = Math.min(100, Math.max(1, Number(cantidad.value) || 1));
    const valores = Array.from(lista.querySelectorAll('input[name^="Pasajeros["]')).map(x => x.value);
    lista.replaceChildren();
    for (let i=0; i<n; i++) {
      const grupo=document.createElement("div");
      grupo.className="mb-2";
      const label=document.createElement("label");
      label.className="form-label";
      label.htmlFor="pasajero_"+i;
      label.textContent="Pasajero "+(i+1);
      const campo=document.createElement("input");
      campo.id="pasajero_"+i;
      campo.name="Pasajeros["+i+"]";
      campo.value=valores[i] || "";
      campo.className="form-control";
      campo.required=true;
      campo.minLength=3;
      campo.maxLength=120;
      campo.autocomplete="off";
      grupo.append(label,campo);
      lista.append(grupo);
    }
  };
  cantidad.addEventListener("change", () => { actualizarNombres(); revisarCupos(); });
  cantidad.addEventListener("input", () => { actualizarNombres(); revisarCupos(); });
  tour.addEventListener("change", revisarCupos);
  actualizarNombres();
  revisarCupos();
})();

document.getElementById("crearReservaForm").addEventListener("submit", function () {
    if (!this.checkValidity()) return;
    const boton = document.getElementById("guardarReserva");
    boton.disabled = true;
    boton.textContent = "Guardando...";
});
</script>
}
