@model CrearReservaViewModel
@{
    ViewData["Title"] = "Crear reserva";
}
<section class="inner-hero dashboard-hero">
    <div class="container">
        <a class="back-link" asp-controller="ReservasWeb" asp-action="Index">← Volver a reservas</a>
        <span class="eyebrow">OPERACIONES · TOURSMART RD</span>
        <h1>Nueva <em>reserva.</em></h1>
        <p>Registra una nueva experiencia para un cliente de tu agencia.</p>
    </div>
</section>
<section class="section-space">
    <div class="container">
        <div class="tour-admin-form">
            <span class="eyebrow">DATOS DE RESERVA</span>
            <h2 class="mt-2 mb-4">Comencemos <em>la aventura.</em></h2>
            <form method="post" asp-controller="ReservasWeb" asp-action="Crear" id="crearReservaForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                            <option value="0">Selecciona un cliente</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="small text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MetodoPagoId" class="form-label">Método de pago</label>
                        <select asp-for="MetodoPagoId" asp-items="Model.MetodosPago" class="form-select">
                            <option value="0">Selecciona un método</option>
                        </select>
                        <span asp-validation-for="MetodoPagoId" class="small text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="TourId" class="form-label">Excursión disponible</label>
                        <select asp-for="TourId" asp-items="Model.Tours" class="form-select">
                            <option value="0">Selecciona un tour</option>
                        </select>
                        <span asp-validation-for="TourId" class="small text-danger"></span>
                        <small class="text-secondary">Solo se muestran tours futuros con plazas disponibles.</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CantidadPersonas" class="form-label">Cantidad de personas</label>
                        <input asp-for="CantidadPersonas" type="number" min="1" max="100" class="form-control" />
                        <span asp-validation-for="CantidadPersonas" class="small text-danger"></span>
                    </div>
                </div>
                <div class="booking-status mt-4">La reserva se creará en estado <strong>Pendiente</strong>. Se ocuparán las plazas indicadas hasta confirmar o cancelar la reserva.</div>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button type="submit" class="btn btn-accent" id="guardarReserva">Crear reserva ↗</button>
                    <a asp-controller="ReservasWeb" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
<script>
document.getElementById("crearReservaForm").addEventListener("submit", function () {
    const boton = document.getElementById("guardarReserva");
    boton.disabled = true;
    boton.textContent = "Guardando...";
});
</script>
}
