@model CatalogoViewModel
@inject IWebHostEnvironment Ambiente
@{
    ViewData["Title"] = "Descubre tu próxima aventura";
    var fotoPortada = TourSmart.Web.Services.PortadaImagen.Obtener(Ambiente);
}
<section class="hero ts-v3-hero">
    <div class="container hero-content">
        <div class="hero-text">
            <div class="hero-eyebrow"><span class="live-dot"></span> UNA NUEVA FORMA DE EXPLORAR</div>
            <h1>La aventura comienza <em>antes de partir.</em></h1>
            <p class="hero-description">Descubre lugares increíbles, encuentra la excursión ideal y organiza cada detalle sin complicaciones. Tu próxima historia empieza aquí.</p>
            <div class="hero-actions">
                <a asp-controller="Tours" asp-action="Index" class="btn btn-accent btn-lg">Descubrir excursiones <span>↗</span></a>
                <a href="#como-funciona" class="hero-secondary-link">Así funciona <span>↓</span></a>
            </div>
            <div class="hero-proof"><div class="avatar-group"><span>☼</span><span>✈</span><span>✦</span></div><p><strong>Viaja con más confianza.</strong><br />Países, destinos, plazas y reservas en un solo lugar.</p></div>
        </div>
        <div class="hero-visual ts-v3-visual @(fotoPortada is null ? "" : "ts-hero-con-foto")" aria-hidden="true">
            @if (fotoPortada is not null)
            {
                <img class="ts-hero-main-image" src="@fotoPortada" alt="" loading="eager" fetchpriority="high" onerror="this.style.display='none';this.parentElement.classList.remove('ts-hero-con-foto')" />
            }
            <div class="sun-orb"></div><div class="landscape-back"></div><div class="landscape-front"></div><div class="ts-v3-visual-orbit"></div>
            <div class="floating-tag floating-tag-one">✦ Rutas que inspiran</div>
            <div class="floating-tag floating-tag-two">↗ Tu próxima escapada</div>
            <div class="vertical-word">DISCOVER MORE · TOURSMART RD</div>
        </div>
    </div>
    <div class="hero-bottom container"><span>TOURSMART RD · EXPLORA MÁS</span><span>TU PRÓXIMA HISTORIA ESTÁ AFUERA <span>↗</span></span></div>
</section>

<section class="ts-v3-benefits" aria-label="Ventajas de TourSmart RD"><div class="container"><div class="ts-v3-benefits-grid"><div><span>01 / DESCUBRE</span><strong>Destinos que emocionan</strong><small>Explora opciones de viaje por país y lugar.</small></div><div><span>02 / ORGANIZA</span><strong>Todo más sencillo</strong><small>Consulta fechas, precios y disponibilidad.</small></div><div><span>03 / DISFRUTA</span><strong>Viaja a tu manera</strong><small>Prepara tu experiencia desde un solo lugar.</small></div></div></div></section>
<section class="section-space" id="destacados">
    <div class="container">
        <div class="ts-banner mb-5"><div><h3>¿Listo para descubrir tu próxima escapada?</h3><p>Encuentra excursiones según el país, el destino y las plazas disponibles.</p></div><a asp-controller="Tours" asp-action="Index" class="btn btn-accent">Buscar una experiencia ↗</a></div>
        <div class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div><span class="eyebrow">NUESTRA SELECCIÓN</span><h2>Experiencias para <em>recordar.</em></h2><p>Explora excursiones disponibles en nuestro catálogo.</p></div>
            <a asp-controller="Tours" asp-action="Index" class="section-link">Ver todos los tours <span>↗</span></a>
        </div>
        @if (!Model.ServicioDisponible)
        {
            <div class="service-alert" role="status">No pudimos conectar con la API de tours. Inicia AgenciaToursAPI en el puerto 5290 y recarga esta página.</div>
        }
        else if (!Model.Tours.Any())
        {
            <div class="empty-box">Aún no hay excursiones disponibles. Muy pronto podrás descubrir nuevas aventuras.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var tour in Model.Tours)
                {
                    <div class="col-md-6 col-xl-4"><partial name="_TourCard" model="tour" /></div>
                }
            </div>
        }
    </div>
</section>
<section class="how-section section-space" id="como-funciona">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5"><span class="eyebrow">VIAJAR, MÁS FÁCIL</span><h2>Tres pasos.<br /><em>Muchos recuerdos.</em></h2><p>Una forma práctica de descubrir excursiones, revisar sus detalles y preparar tu próxima salida.</p><a asp-controller="Tours" asp-action="Index" class="btn btn-dark-pill">Explorar tours ↗</a></div>
            <div class="col-lg-7"><div class="row g-3">
                <div class="col-md-4"><div class="step-card"><span>01</span><strong>Explora</strong><p>Descubre tours y destinos disponibles.</p></div></div>
                <div class="col-md-4"><div class="step-card"><span>02</span><strong>Compara</strong><p>Consulta precios, duración y cupos.</p></div></div>
                <div class="col-md-4"><div class="step-card"><span>03</span><strong>Planifica</strong><p>Elige la aventura que más te inspire.</p></div></div>
            </div></div>
        </div>
    </div>
</section>
